# Build output. `make build` produces the binary; `make web` produces the frontend
# bundle. The binary never belongs in git. The bundle does not either, with one
# exception: dist/index.html is committed, because //go:embed needs a file to match
# and a checkout must compile without Node. `make web` overwrites it.
/bin/
/internal/web/dist/assets/
/web/node_modules/

# The interface smoke's own artefacts: a failing Playwright run writes the page it saw
# into test-results/, which is useful to read once and never belongs in git.
/web/test-results/
/web/playwright-report/

# Local scratch: plans, notes, one-off experiments.
/.scratch/

# The acceptance environment's scratch root: a run's corpus, library and database.
/acceptance/scratch/
/acceptance/scratch-falsify/
